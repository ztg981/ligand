{
  "manifest_version": 3,
  "name": "Ligand",
  "version": "0.4.0",
  "description": "Quick tasks, notes and logs into Ligand, plus your Pomodoro and the tab group you're working in.",
  "permissions": ["tabs", "tabGroups", "storage", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ligand",
    "default_icon": { "128": "icons/icon-128.png" }
  },
  "icons": { "128": "icons/icon-128.png", "512": "icons/icon-512.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
